# AKP Commander Hybrid Pro — wzór konfiguracji (bez sekretów)
# Wymagane do uruchomienia API. Brak którejkolwiek zmiennej => 503, bez demonstracyjnej bazy RAM.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=

# Opcjonalna integracja Google (nie wpływa na logowanie Supabase)
GOOGLE_CLIENT_ID=

# Nie umieszczaj .env w Git ani sekretów service_role w kodzie frontendowym.
# Staging i produkcja muszą mieć osobne bazy i jawnie ustawione domeny.
